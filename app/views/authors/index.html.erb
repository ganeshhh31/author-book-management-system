<div class="listing-container">

  <div class="listing-header">
    <h1>Listing of Authors</h1>
  </div>

  <div class="search-container">
    <input
      type="text"
      id="author-search"
      placeholder="Search authors..."
    >

    <p id="author-not-found" class="not-found-message">
      Author not found
    </p>
  </div>

  <div id="author-list">

   <% @authors.each do |author| %>
  <p class="author-item">

    <%= link_to author_path(author) do %>
      <%= author.first_name %>
      <%= author.last_name %>
      <%= author.date_of_birth %>
    <% end %>

  </p>
<% end %>

  </div>

  <%= link_to "Create New Author", new_author_path, class: "create-button" %>

  <br>

  <%= link_to "← Back to Home", root_path, class: "home-button" %>

</div>